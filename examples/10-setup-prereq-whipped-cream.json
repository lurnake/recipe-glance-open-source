      "uses": [],
      "duration": { "raw": "10 min", "minMinutes": 10, "maxMinutes": 10 }
    },
    {
      "id": "whip",
      "kind": "transform",
      "instruction": "Whip cream, sugar, and vanilla to soft peaks",
      "label": "whip to soft peaks",
      "uses": [
        { "id": "u-cream", "source": { "kind": "ingredient", "ingredientId": "cream" } },
        { "id": "u-sugar", "source": { "kind": "ingredient", "ingredientId": "sugar" } },
        { "id": "u-van", "source": { "kind": "ingredient", "ingredientId": "vanilla" } }
      ],
      "after": ["chill"],
      "outputs": [{ "id": "out-cream", "name": "whipped cream" }]
    }
  ]
