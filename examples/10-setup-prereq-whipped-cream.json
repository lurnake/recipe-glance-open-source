{
  "version": "rgf/0-draft",
  "meta": {
    "title": "Soft Whipped Cream (chill bowl first)",
    "servings": "about 2 cups",
    "source": "original fixture (setup prerequisites)"
  },
  "ingredients": [
    { "id": "cream", "text": "1 cup (240 mL) heavy cream, cold" },
    { "id": "sugar", "text": "1 Tbsp powdered sugar" },
    { "id": "vanilla", "text": "1/2 tsp vanilla extract" }
  ],
  "steps": [
    {
      "id": "chill",
      "kind": "setup",
      "instruction": "Chill a metal bowl and whisk (or beaters) for 10 minutes",
